# Copy to backend/.env and fill in values (backend/.env is git-ignored)

# Database
#  - Local dev: leave DATABASE_URL empty -> SQLite file backend/pramax.db is used.
#  - Production: paste your Neon (or other hosted PostgreSQL) connection string, e.g.
#    postgresql://user:password@ep-xxxx.region.aws.neon.tech/pramax?sslmode=require
DATABASE_URL=

# Key the admin endpoints expect in the "X-Admin-Key" header
ADMIN_API_KEY=change-me-to-a-long-random-string

# xAI Grok — required for /api/chat
XAI_API_KEY=
GROK_MODEL=grok-4.5

# Browser origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Chat rate limits (optional; these are the defaults). Every chat message costs
# money at the AI provider, so visitors and the daily total are capped.
CHAT_LIMIT_PER_MINUTE=10
CHAT_LIMIT_PER_DAY=100
CHAT_LIMIT_TOTAL_PER_DAY=2000
